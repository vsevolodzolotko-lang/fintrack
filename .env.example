# ─── Cloudflare Tunnel ───
# Токен з Cloudflare Zero Trust → Networks → Tunnels → ваш тунель → Configure → Token
CLOUDFLARE_TUNNEL_TOKEN=

# ─── База даних ───
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=fintrack
# URL, який бачить бекенд у docker-мережі
DATABASE_URL=postgresql://fintrack:change-me-strong@db:5432/fintrack?schema=public

# ─── Бекенд ───
NODE_ENV=production
PORT=3000
# Секрет для підпису сесійних cookie (openssl rand -hex 32)
SESSION_SECRET=change-me-64-hex-chars
# 32-байтний ключ (hex) для AES-256-GCM шифрування Mono-токенів (openssl rand -hex 32)
TOKEN_ENC_KEY=change-me-64-hex-chars
# Публічний базовий URL (для формування webHookUrl у Mono)
PUBLIC_BASE_URL=https://fintrack.yourdomain.com

# ─── Часовий пояс ───
TZ=Europe/Kyiv

# ─── Binance (крипто-портфель, read-only) ───
# Binance → API Management → Create API. Залишити ЛИШЕ "Enable Reading",
# зняти "Enable Spot & Margin Trading" і "Enable Withdrawals". IP restriction — IP сервера.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Спот-пари для імпорту myTrades (через кому)
BINANCE_SPOT_SYMBOLS=BTCUSDT,ETHUSDT
# Лінія відліку (ISO-дата): угоди раніше неї не імпортуються. Порожньо = вся доступна історія.
BINANCE_SYNC_FROM=

# ─── Web Push (Фаза 2) — згенерувати: npx web-push generate-vapid-keys ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
